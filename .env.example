# Neon Postgres connection string (pooled or direct, with sslmode=require)
DATABASE_URL=postgres://user:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Secret key for hashing member DNIs (HMAC-SHA256), >= 32 chars, e.g. `openssl rand -base64 48`.
# Set it BEFORE running `npm run import:members`; changing it later invalidates every stored hash.
DNI_PEPPER=XRU3gF9TOWD1Emz0kBR0daXRcD06c4IzYixMOZWB_Y0

# Admin panel login
ADMIN_PASSWORD=change-me-too

# Secret used to sign the admin session cookie (>= 32 chars, e.g. `openssl rand -base64 48`)
ADMIN_SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Optional ISO 8601 deadline. Example: 2026-10-30T12:00:00-05:00 (leave empty for no deadline)
REGISTRATION_CLOSES_AT=
